{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": { "@gatekeeper/*": ["packages/gatekeeper/src/*"] }
  },
  "include": ["./**/*", "../packages/gatekeeper/src/**/*"],
  "exclude": ["./_generated"]
}
