# Frontend (Vite) — safe to expose
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_SITE_URL=http://localhost:5173
# Product analytics (off without a key): anonymous events to PostHog, no cookies, no recording
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Convex deployment (set via `npx convex env set` — never commit real values)
# OPENROUTER_API_KEY=            judge, red-team, diff review; also injected into the sandbox at egress
# JUDGE_MODEL=google/gemini-2.5-flash
# REDTEAM_MODEL=google/gemini-3.1-flash-lite
# REVIEW_MODEL=anthropic/claude-haiku-4.5
# CODER_MODEL=anthropic/claude-sonnet-5
# JUDGE_ADDENDUM=                private extra rules appended to the judge prompt at runtime
# VERCEL_TOKEN=                  for Vercel Sandbox from Convex Node actions
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=        PEM, newlines as \n
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_REPO=anyone-build/anyone.build
# STRIPE_SECRET_KEY=              bids are authorization holds (manual capture); only the winner is charged
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=                outbid / won / released emails
# RESEND_FROM="anyone.build <patron@mail.anyone.build>"
# ALLOW_FAKE_PAYMENTS=1          dev only
# BETTER_AUTH_SECRET=
# GITHUB_CLIENT_ID=              GitHub OAuth app for login
# GITHUB_CLIENT_SECRET=
# SITE_URL=https://anyone.build
