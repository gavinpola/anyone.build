{
  "name": "anyone.build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The website anyone can change. Point at something, say what should change, watch it ship.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/gen-manifest.mjs && vite",
    "dev:convex": "convex dev",
    "build": "node scripts/gen-manifest.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p convex/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:playground": "node scripts/validate-playground.mjs",
    "eval:judge": "vitest run --config vitest.eval.config.ts",
    "refresh-snapshot": "node scripts/refresh-snapshot.mjs",
    "smoke": "playwright test",
    "sync:manifest": "node scripts/gen-manifest.mjs",
    "e2e": "E2E_URL=http://127.0.0.1:5173 playwright test tests/e2e",
    "sync:constitution": "node scripts/sync-constitution.mjs",
    "playtest": "playwright test --config playwright.blocks.config.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.3.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-router": "^1.170.32",
    "@vercel/sandbox": "^3.2.1",
    "ai": "^7.0.91",
    "better-auth": "~1.6.11",
    "convex": "^1.45.0",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.25.0",
    "satori": "^0.33.4",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "magic-string": "^0.30.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
